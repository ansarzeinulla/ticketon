# BiletFlow - local database environment
# Copy to .env before running `docker compose up`.

POSTGRES_USER=biletflow
POSTGRES_PASSWORD=biletflow_dev_password
POSTGRES_DB=biletflow

# Host port for the PostgreSQL container (container always listens on 5432).
# 5433 is used by default so it does not clash with a locally installed PostgreSQL.
POSTGRES_PORT=5433

# Optional pgAdmin container (started only with: docker compose --profile tools up)
PGADMIN_EMAIL=admin@biletflow.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Phase 2: Go API ---------------------------------------------------------

# development | production. Production refuses to start without JWT_SECRET.
BILETFLOW_ENV=development

API_HOST=0.0.0.0
API_PORT=8080

# The API connects over the host port above, so it can run outside Docker.
DATABASE_URL=postgres://biletflow:biletflow_dev_password@localhost:5433/biletflow?sslmode=disable

# Signing key for access tokens. Generate a real one for anything shared:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ISSUER=biletflow
ACCESS_TOKEN_TTL=24h

# bcrypt work factor. 12 is the production default; the tests drop it to 4.
BCRYPT_COST=12
