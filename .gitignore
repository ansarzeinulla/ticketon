# BiletFlow
#
# Anything a build, a test run, or the running application produces is ignored;
# anything a person wrote is not. The verification artifacts under docs/ are a
# deliberate exception - they are the evidence for the SRS traceability matrix,
# so they are committed rather than regenerated.

# --- Secrets and local configuration ------------------------------------------
# .env carries the database password and the JWT signing key. .env.example is
# the committed template it is copied from - see the Makefile's `up` target.
.env
.env.local
.env.*.local
*.env.local

# --- Dependencies -------------------------------------------------------------
node_modules/

# --- Go -----------------------------------------------------------------------
# Compiled by `make api-build`.
api/bin/
# Coverage profiles from `go test -coverprofile`.
*.out
!**/testdata/**/*.out

# --- Uploaded files -----------------------------------------------------------
# Event banners the API writes to local disk, standing in for object storage
# (SRS 4.2). Random filenames, created at runtime, and the handler makes the
# directory itself - so there is nothing here worth keeping in the repository.
# In Docker these live in the biletflow_uploads volume instead.
api/data/uploads/

# --- Next.js ------------------------------------------------------------------
web/.next/
web/out/
web/build/
web/next-env.d.ts

# --- Test output --------------------------------------------------------------
# Playwright writes traces, screenshots and videos for failed specs; the HTML
# report is regenerated on every run.
web/e2e/.results/
web/playwright-report/
web/test-results/
web/blob-report/
web/.playwright/
# Vitest coverage.
web/coverage/

# --- Expo / React Native ------------------------------------------------------
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.metro-health-check*
# Generated by `expo prebuild`; this project runs through Expo Go and does not
# commit native projects.
mobile/ios/
mobile/android/

# --- Signing material ---------------------------------------------------------
# Never commit these, even by accident.
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem

# --- TypeScript ---------------------------------------------------------------
*.tsbuildinfo

# --- Logs ---------------------------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.pnpm-debug.*

# --- Editors and OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Agent tooling ------------------------------------------------------------
.claude/

# --- Deliberately NOT ignored -------------------------------------------------
# docs/verification/  - the traceability matrix, measured results and the
#                       screenshots backing the §11 success criteria.
# db/, api/, web/src/, mobile/app/, .github/workflows/, Dockerfiles,
# docker-compose.yml, Makefile, .env.example
